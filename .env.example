# AWS Region & Credentials
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# DynamoDB Configuration
DYNAMODB_TABLE_NAME=StudentAttendance
# Set DYNAMODB_ENDPOINT for local development (e.g. http://localhost:8000). Leave empty for real AWS.
DYNAMODB_ENDPOINT=http://localhost:8000

# Cognito Configuration
# Set COGNITO_ENDPOINT for local development (e.g. http://localhost:9229). Leave empty for real AWS.
COGNITO_ENDPOINT=http://localhost:9229
COGNITO_USER_POOL_ID=us-east-1_localpool
COGNITO_CLIENT_ID=localappclient12345

# JWT Verification Configuration
# For local dev / testing, use secret below. For production AWS Cognito, leave JWT_SECRET unset to use JWKS.
JWT_SECRET=local-dev-jwt-secret-key-123456789
# Optional: explicitly provide a JWKS URI if overriding standard Cognito well-known URL
# COGNITO_JWKS_URI=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_yourpool/.well-known/jwks.json
